---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LabVisual from '../components/LabVisual.astro';
import LessonList from '../components/LessonList.astro';
import { href, paths, repository } from '../lib/site';
const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a,b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
---
<Base>
  <section class="shell hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> TECHNICAL IDEAS, MADE CLEAR</p>
      <h1>Understand it.<br/>Explain it.<br/><span>Try it.</span></h1>
      <p class="hero-description">A place to make sense of networks, security, and the systems we use. Clear English explanations. Useful diagrams. Practice that makes it stick.</p>
      <div class="hero-actions"><a class="button primary" href="#learning-paths">Explore the learning paths <span aria-hidden="true">↘</span></a><a class="text-link" href={href('about/')}>Meet the lab <span aria-hidden="true">↗</span></a></div>
      <p class="hero-note">Built around curiosity. Improved through practice.</p>
    </div>
    <LabVisual />
  </section>
  <section class="intro-strip"><div class="shell"><p><span>WATCH</span> Understand the idea.</p><p><span>READ</span> Explore it in detail.</p><p><span>TRY</span> Put it into practice.</p></div></section>
  <section class="shell section" id="learning-paths">
    <div class="section-heading"><div><p class="eyebrow">CHOOSE YOUR STARTING POINT</p><h2>Four paths.<br/>Plenty to discover.</h2></div><p>Start with a question. Follow the explanation.<br/>Leave with something you can use.</p></div>
    <div class="path-list">
      {paths.map(path => <a class="path-row" href={href(`topics/${path.id}/`)}>
        <span class="path-number">{path.number}</span><span class="path-symbol" aria-hidden="true">{path.symbol}</span>
        <div class="path-title"><h3>{path.name}</h3><span>{path.tagline}</span></div><p>{path.description}</p><span class="path-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
  </section>
  <section class="shell section latest-section">
    <div class="section-heading"><div><p class="eyebrow">FROM THE LAB</p><h2>{lessons.length ? 'The latest lessons.' : 'We’re starting with the basics.'}</h2></div>{lessons.length > 0 && <a class="text-link" href={href('lessons/')}>All lessons ↗</a>}</div>
    {lessons.length > 0 ? <LessonList lessons={lessons.slice(0,3)} /> : <div class="first-lesson">
      <div class="lesson-stamp" aria-hidden="true">01<span>FIRST UP</span></div>
      <div><span class="tag">NETWORK · IN PREPARATION</span><h3>What Is a Computer Network?</h3><p>Start with connected devices, shared resources, and a simple question: can a local network work without the internet?</p><a class="text-link" href={href('topics/network/')}>Explore the Network path ↗</a></div>
    </div>}
  </section>
  <section class="shell lab-note"><div><p class="eyebrow">LEARN IT. THEN EXPLAIN IT.</p><h2>Understanding grows<br/>when you put it into words.</h2></div><div><p>MBR CyberLab brings technical learning and English speaking practice together. Each lesson is a chance to understand one idea, explain it clearly, and build something useful to return to.</p><a class="text-link" href={repository}>Follow the project on GitHub ↗</a></div></section>
</Base>
